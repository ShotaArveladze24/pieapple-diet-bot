# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (the primary user; also receives error notifications).
# Get it by messaging @userinfobot on Telegram.
OWNER_TELEGRAM_ID=

# Comma-separated extra Telegram user ids also allowed to use the bot (optional).
EXTRA_TELEGRAM_IDS=

# SQLite database file
DATABASE_PATH=data/pieapple.db

# Where request/response JSON files for the AI queue are exchanged with the external
# Claude Code consumer (see ai_queue/SPEC.md). No API key needed.
AI_QUEUE_DIR=data/ai_queue
