# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (the primary user; also receives error notifications).
# Get it by messaging @userinfobot on Telegram.
OWNER_TELEGRAM_ID=

# Comma-separated extra Telegram user ids also allowed to use the bot (optional).
EXTRA_TELEGRAM_IDS=

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Path to the Google OAuth "Desktop app" client secrets JSON (see README)
GOOGLE_CLIENT_SECRETS_PATH=client_secret.json

# Path to the cached OAuth token, created by setup_google_auth.py
GOOGLE_TOKEN_PATH=token.json

# Calendar to write meal events to. Defaults to "primary" (your main calendar).
# Use a specific calendar's id (Settings > [calendar] > Integrate calendar > Calendar ID)
# to keep meal events off your main calendar.
GOOGLE_CALENDAR_ID=primary

# SQLite database file
DATABASE_PATH=data/pieapple.db
